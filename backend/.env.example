# Application
APP_NAME=Construction ERP
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg2://erp_user:erp_password@localhost:5432/construction_erp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=construction_erp

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin seed
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@constructionerp.app
ADMIN_PASSWORD=change-me-on-first-login

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080